@page "/"
@attribute [AllowAnonymous]

<PageTitle>Closed Services Admin</PageTitle>

<GdsHeading Level="1" Size="GdsSize.Large">Closed Services Admin</GdsHeading>

<p>Welcome to the Closed Services Admin portal.</p>

<AuthorizeView>
    <Authorized>
        @if (isLoading)
        {
            <GdsSpinner Show Message="Loading services..." ShowMessage></GdsSpinner>
        }
        else
        {
            @if (Services.Count == 0)
            {
                <p>You do not have permission to update any services.</p>
            }
            else
            {
                <p>You have permission to update the following services.</p>
                <ul>
                    @foreach (var service in Services.GroupBy(s => s.ServiceType))
                    {
                        string link = $"services/{service.Key}";

                        <li><GdsLink Href="@link">@service.Key</GdsLink></li>
                    }
                </ul>
            }
        }
    </Authorized>
    <NotAuthorized>
        <p><GdsLink Href="/sign-in">Sign in</GdsLink> to update your service</p>
        <GdsHeading Level="2" Size="GdsSize.Medium">What is Closed Services Admin?</GdsHeading>
        <p>Closed Services Admin is a portal that allows authorized users to manage and update closed services within the organization.</p>
        <p>If you manage a service, and don't have an account, you can request access by contacting [contact goes here].</p>
    </NotAuthorized>
</AuthorizeView>


