@page "/services/{ServiceTypeRoute}"

<PageTitle>Services - Closed Services Admin</PageTitle>

<GdsBackLink Href="" />

<GdsHeading Level="1">Services</GdsHeading>

@if(isLoading)
{
    <GdsSpinner Show Message="Loading services..." ShowMessage></GdsSpinner>
}
else
{
    if (ServiceOverviews.Count == 0)
    {
        <p>You do not have permission to update any @ServiceTypeDisplayName.</p>
    }
    else
    {
        <p>The list below shows all @ServiceTypeDisplayName.ToLowerInvariant() you have permission to update.</p>
        <GdsTaskList>
            @foreach (var serviceOverview in ServiceOverviews.OrderBy(overview => overview.Service.Name))
            {
                string link = $"services/{ParsedServiceType}/update/{serviceOverview.Service.Id}";

                <GdsTaskListItem Text="@serviceOverview.Service.Name" Href="@link">
                    <Status>
                        <GdsTag Text="@GetStatusText(serviceOverview.CurrentStatus.ClosureState)" Colour="@GetStatusTagColour(serviceOverview.CurrentStatus.ClosureState)" />
                    </Status>
                </GdsTaskListItem>
            }

        </GdsTaskList>

    }
}


