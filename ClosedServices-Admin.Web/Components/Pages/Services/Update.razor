@page "/services/{ServiceTypeRoute}/update/{ServiceId:guid}"
@using Humanizer

@if (isLoading)
{
    <GdsSpinner Show Message="Loading service..." ShowMessage />
}
else if (Service is not null)
{
    <PageTitle>Update @Service.Name - Closed Services Admin</PageTitle>
    <GdsBackLink Href="@BackLink" />
    <GdsHeading Level="1">Update @Service.Name</GdsHeading>

    @if (ShowRemovalSuccessMessage)
    {
        <GdsInsetText>
            <strong>Closure removed successfully.</strong>
        </GdsInsetText>
    }

    @if (RemovableClosure is not null)
    {
        <GdsNotificationBanner BannerTitle="Current/Upcoming closure">
            <p>@ClosureStatusText</p>
            <GdsLink Href="@RemovalConfirmationLink">Remove this closure</GdsLink>
        </GdsNotificationBanner>
    }
    else
    {
        <GdsInsetText>
            <strong>This @Service.ServiceType.ToString().Singularize().ToLowerInvariant() has no current or planned closures</strong>
        </GdsInsetText>
    }

    @if (ValidationError is not null)
    {
        <GdsErrorMessage>@ValidationError</GdsErrorMessage>
    }

    <EditForm Model="this" OnValidSubmit="SaveAsync">
        <GdsFormGroup>
            <GdsFieldsetGroup>
                <GdsFieldsetLegend><GdsFieldsetHeading Level="2">Are you fully closed or partially closed?</GdsFieldsetHeading></GdsFieldsetLegend>
                <GdsRadios @bind-Value="SelectedClosureState">
                    
                    <GdsRadioItem><GdsInputRadio Value="@ClosureState.Closed" /><GdsRadioLabel Text="Closed" /></GdsRadioItem>
                    <GdsRadioItem><GdsInputRadio Value="@ClosureState.PartiallyClosed" /><GdsRadioLabel Text="Partially closed" /></GdsRadioItem>
                </GdsRadios>
            </GdsFieldsetGroup>
        </GdsFormGroup>

        <GdsFormGroup>
            <GdsFieldsetGroup>
                <GdsFieldsetLegend><GdsFieldsetHeading Level="2">When are you closed?</GdsFieldsetHeading></GdsFieldsetLegend>
                <GdsRadios @bind-Value="SelectedDuration">
                    @if (ShowTodayOption)
                    {
                        <GdsRadioItem><GdsInputRadio Value="@("today")" /><GdsRadioLabel Text="Today" /></GdsRadioItem>
                    }

                    @if (ShowTodayAndNextOption)
                    {
                        <GdsRadioItem><GdsInputRadio Value="@("today-and-next")" /><GdsRadioLabel Text="@($"Today and {NextOperatingDayLabel}")" /></GdsRadioItem>
                    }

                    @if (ShowTomorrowOption)
                    {
                        <GdsRadioItem><GdsInputRadio Value="@("tomorrow")" /><GdsRadioLabel Text="@NextOperatingDayLabel" /></GdsRadioItem>
                    }

                    <GdsRadioItem><GdsInputRadio Value="@("custom")" /><GdsRadioLabel Text="Custom" /></GdsRadioItem>
                </GdsRadios>
            </GdsFieldsetGroup>
        </GdsFormGroup>

        @if (SelectedDuration == "custom")
        {
            <GdsFormGroup><GdsLabel Text="Start date" /><InputDate @bind-Value="StartDate" class="govuk-input" /><GdsHint>Start time is optional.</GdsHint><input type="time" @bind="StartTime" class="govuk-input" /></GdsFormGroup>
            <GdsFormGroup><GdsLabel Text="End date" /><InputDate @bind-Value="EndDate" class="govuk-input" /><GdsHint>End date and time are optional.</GdsHint><input type="time" @bind="EndTime" class="govuk-input" /></GdsFormGroup>
        }

        <GdsFormGroup>
            <GdsHeading Level="2">Would you like to provide further information?</GdsHeading>
            <GdsLabel Text="Message (optional)" />
            <GdsHint>Provide any additional information about what is closed and why.</GdsHint>
            <InputTextArea rows="3" class="govuk-textarea" @bind-Value="Message" />
        </GdsFormGroup>
        <button class="govuk-button" type="submit" disabled="@isSaving">Save status</button>
    </EditForm>
}