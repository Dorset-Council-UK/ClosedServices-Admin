@model ClosedServices_Admin.Pages.Embed.ClosureDisplayModel
@using ClosedServices_Admin.Pages.Embed
<p>
    From <time datetime="@ServiceStatusModel.MachineDate(Model.Closure.EffectiveFrom)">@ServiceStatusModel.FormatDate(Model.Closure.EffectiveFrom)</time>
    @if (Model.Closure.EffectiveTo is { } end)
    {
        <span>until <time datetime="@ServiceStatusModel.MachineDate(end)">@ServiceStatusModel.FormatDate(end)</time>.</span>
    }
    else
    {
        <span>until further notice.</span>
    }
</p>
@if (!string.IsNullOrWhiteSpace(Model.Closure.Reason))
{
    <p>Reason: @Model.Closure.Reason</p>
}
@if (Model.ShowMessages && !string.IsNullOrWhiteSpace(Model.Closure.Message))
{
    <p class="message">@Model.Closure.Message</p>
}
